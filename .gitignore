# CKP-25 paper companion repository
# Publish policy: ignore everything by default, then allow only the
# reproducible GROMACS workflow, curated inputs, manuscript, and docs.

/*

# Repository metadata and public documentation
!/.gitignore
!/README.md
!/environment.yml
!/mmpbsa.in
!/LICENSE
!/LICENSE.*
!/CITATION.cff
!/.github/
!/.github/**

# Curated paper inputs
!/Data/
/Data/*
!/Data/README.md
!/Data/metadata.tsv
!/Data/ckp25.smiles
!/Data/proteins/
/Data/proteins/*
!/Data/proteins/*.pdb
!/Data/docked_poses/
/Data/docked_poses/*
!/Data/docked_poses/*.sdf

# Workflow figure for the GitHub README
!/docs/
/docs/*
!/docs/workflow.pdf
!/docs/workflow.png

# Active GROMACS pipeline
!/gromacs_files/
/gromacs_files/*
!/gromacs_files/3Dmol-min.js
!/gromacs_files/jquery.min.js
!/gromacs_files/_mdrun_progress.py
!/gromacs_files/analyze_gmx.py
!/gromacs_files/make_viewer_gmx.py
!/gromacs_files/prepare_complex_gmx.py
!/gromacs_files/run_MD_gromacs.sh
!/gromacs_files/run_simulation_gmx.sh

# Paper-level wrapper scripts
!/scripts/
/scripts/*
!/scripts/*.sh

# Analysis and MM-GBSA helper scripts used by the wrappers/README
!/convert_topologies.py
!/extract_mmpbsa_traj.py
!/extract_metrics_all.py
!/plot_all_metrics.py
!/plot_mmpbsa_bar.py
!/plot_polar_stability.py
!/plot_rmsf_rg_combined.py
!/make_combined_heatmap.py

# Active manuscript source and figures referenced by mdpi.tex
!/MDPI_MD_on_COVID_targets_paper/
/MDPI_MD_on_COVID_targets_paper/*
!/MDPI_MD_on_COVID_targets_paper/mdpi.tex
!/MDPI_MD_on_COVID_targets_paper/refs.bib
!/MDPI_MD_on_COVID_targets_paper/Definitions/
!/MDPI_MD_on_COVID_targets_paper/Definitions/**
!/MDPI_MD_on_COVID_targets_paper/images/
/MDPI_MD_on_COVID_targets_paper/images/*
!/MDPI_MD_on_COVID_targets_paper/images/workflow.pdf
!/MDPI_MD_on_COVID_targets_paper/images/5_covid_targets_best_pose_with_cpk25.pdf
!/MDPI_MD_on_COVID_targets_paper/images/md_protein_rmsd.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_ligand_rmsd.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_ligand_boxplot.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_contacts.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_contact_heatmap_5panel.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_rmsf_rg_stability.jpg
!/MDPI_MD_on_COVID_targets_paper/images/md_polar_contacts_stability.jpg

# Keep all generated outputs, local state, prototypes, and scratch files hidden.
