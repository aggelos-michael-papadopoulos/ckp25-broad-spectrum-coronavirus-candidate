# CKP-25 paper companion repository
# Publish policy: ignore everything by default, then allow only the
# reproducible GROMACS workflow, curated inputs, workflow image, and docs.

/*

# Repository metadata and public documentation
!/.gitignore
!/README.md
!/environment.yml
!/mmpbsa.in
!/LICENSE
!/LICENSE.*
!/CITATION.cff
!/sample_result.gif
!/.github/
!/.github/**

# Curated paper inputs
!/Data/
/Data/*
!/Data/README.md
!/Data/metadata.tsv
!/Data/ckp25.smiles
!/Data/proteins/
/Data/proteins/*
!/Data/proteins/*.pdb
!/Data/docked_poses/
/Data/docked_poses/*
!/Data/docked_poses/*.sdf

# Workflow figure for the GitHub README
!/images/
/images/*
!/images/workflow.pdf
!/images/workflow.png

# Active GROMACS pipeline
!/gromacs_files/
/gromacs_files/*
!/gromacs_files/3Dmol-min.js
!/gromacs_files/3Dmol-min.js.LICENSE.txt
!/gromacs_files/jquery.min.js
!/gromacs_files/_mdrun_progress.py
!/gromacs_files/analyze_gmx.py
!/gromacs_files/make_viewer_gmx.py
!/gromacs_files/prepare_complex_gmx.py
!/gromacs_files/run_MD_gromacs.sh
!/gromacs_files/run_simulation_gmx.sh

# Paper-level wrapper scripts
!/scripts/
/scripts/*
!/scripts/*.sh
!/scripts/export_paper_results.py
!/scripts/create_plots/
/scripts/create_plots/*
!/scripts/create_plots/*.py

# Analysis and MM-GBSA helper scripts used by the wrappers/README
!/convert_topologies.py
!/extract_mmpbsa_traj.py
!/extract_metrics_all.py

# Processed numerical source data for manuscript figures/tables.
!/paper_results/
/paper_results/*
!/paper_results/README.md
!/paper_results/docking/
/paper_results/docking/*
!/paper_results/docking/*.csv
!/paper_results/md_processed/
/paper_results/md_processed/*
!/paper_results/md_processed/*.csv
!/paper_results/mmgbsa/
/paper_results/mmgbsa/*
!/paper_results/mmgbsa/*.csv
!/paper_results/figures/
/paper_results/figures/*
!/paper_results/figures/README.md

# Keep all generated outputs, local state, prototypes, and scratch files hidden.

# Python and IDE artifacts
**/__pycache__/
**/.ipynb_checkpoints/
.idea/
